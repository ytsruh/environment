{
	"$schema": "https://opencode.ai/config.json",
	"enabled_providers": ["opencode", "opencode-go", "openrouter"],
	"plugin": [],
	"provider": {},
	"autoupdate": true,
	"permission": {
  	"read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
		"edit": "allow",
		"glob":"allow",
		"grep":"allow",
		"skill":"allow",
		"webfetch":"allow",
		"bash": {
	      "*": "ask",
	      "git *": "allow",
	      "grep *": "allow",
	      "make *": "allow"
	  },
	},
	// Custom agents
	"agent": {
		"docs-writer": {
			"description": "Writes and maintains project documentation",
			"mode": "subagent",
			"tools": {
				"bash": false
			},
			"prompt": "You are a technical writer. Create clear, comprehensive documentation.\nFocus on:\n- Clear explanations\n- Proper structure\n- Code examples\n- User-friendly language"
		}
	},
	// MCP Servers
	"mcp": {}
}
